
# ==========================================
# PORTFOLIO - GUILHERME MARTINS
# Git Ignore
# ==========================================

# ------------------------------------------
# VARIAVEIS DE AMBIENTE E SEGREDOS
# ------------------------------------------
.env
.env.*
!.env.example

# Chaves e credenciais
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*serviceAccountKey*.json

# ------------------------------------------
# FIREBASE
# ------------------------------------------
# Cache local
.firebase/

# Logs do Firebase
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# ------------------------------------------
# NODE.JS / NPM
# ------------------------------------------
node_modules/
.npm/
.npmrc.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# LOGS
# ------------------------------------------
logs/
*.log

# ------------------------------------------
# ARQUIVOS TEMPORARIOS
# ------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo

# ------------------------------------------
# CACHE E TESTES
# ------------------------------------------
coverage/
.nyc_output/
.eslintcache
.cache/

# ------------------------------------------
# BUILD
# ------------------------------------------
dist/
build/
out/

# ------------------------------------------
# EDITORES E IDEs
# ------------------------------------------
.vscode/*
!.vscode/extensions.json

.idea/
*.code-workspace

# ------------------------------------------
# SISTEMA OPERACIONAL
# ------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------
# ARQUIVOS DE BACKUP
# ------------------------------------------
*.backup
*.old
*.orig

# ------------------------------------------
# FIREBASE DATA CONNECT
# ------------------------------------------
.dataconnect/
